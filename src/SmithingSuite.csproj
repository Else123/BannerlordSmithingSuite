<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{7A3D9E5C-1B4F-4A62-9C7D-3F6B2E8A0C15}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SmithingSuite</RootNamespace>
    <AssemblyName>SmithingSuite</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <ErrorReport>prompt</ErrorReport>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <!-- Debug configuration: start Bannerlord with this module enabled when debugging. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <StartAction>Program</StartAction>
    <StartProgram>$(BannerlordExePath)</StartProgram>
    <StartArguments>/singleplayer _MODULES_*Native*SandBoxCore*CustomBattle*Sandbox*StoryMode*SmithingSuite*_MODULES_</StartArguments>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <!-- Bannerlord game DLLs via centralized paths in Directory.Build.props. -->
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.CampaignSystem.ViewModelCollection">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.CampaignSystem.ViewModelCollection.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- BasicTooltipViewModel - the view model every vanilla HintWidget binds its DataSource to. -->
    <Reference Include="TaleWorlds.Core.ViewModelCollection">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Core.ViewModelCollection.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Engine">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Engine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.InputSystem">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.InputSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Library.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(BannerlordBinPath)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Mod Configuration Menu (MCM) - workshop assembly, see McmBinPath in Directory.Build.props. -->
    <Reference Include="MCMv5">
      <HintPath>$(McmBinPath)\MCMv5.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- UIExtenderEx - workshop assembly, see UIExtenderBinPath in Directory.Build.props. -->
    <Reference Include="Bannerlord.UIExtenderEx">
      <HintPath>$(UIExtenderBinPath)\Bannerlord.UIExtenderEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Logic\SmithSnapshot.cs" />
    <Compile Include="Logic\RefineFormulaSnapshot.cs" />
    <Compile Include="Logic\MaterialStock.cs" />
    <Compile Include="Logic\SmeltCandidate.cs" />
    <Compile Include="Logic\SmeltPlan.cs" />
    <Compile Include="Logic\SmeltPlanner.cs" />
    <Compile Include="Logic\SmeltRoutingReason.cs" />
    <Compile Include="Logic\RefinePlan.cs" />
    <Compile Include="Logic\RefinePlanner.cs" />
    <Compile Include="Logic\ISmithingConnector.cs" />
    <Compile Include="Logic\ISmithingTrace.cs" />
    <Compile Include="Logic\ReportTone.cs" />
    <Compile Include="Logic\RunReport.cs" />
    <Compile Include="Logic\SmithingRun.cs" />
    <Compile Include="Advisor\AdvisorAxisKind.cs" />
    <Compile Include="Advisor\AdvisorPieceKind.cs" />
    <Compile Include="Advisor\AdvisorPresentation.cs" />
    <Compile Include="Advisor\AdvisorSearchPolicy.cs" />
    <Compile Include="Advisor\ArmourModel.cs" />
    <Compile Include="Advisor\AttackMode.cs" />
    <Compile Include="Advisor\AxisReason.cs" />
    <Compile Include="Advisor\DamageKind.cs" />
    <Compile Include="Advisor\DesignCandidate.cs" />
    <Compile Include="Advisor\DesignEvaluation.cs" />
    <Compile Include="Advisor\DesignOptimizer.cs" />
    <Compile Include="Advisor\IDesignEvaluator.cs" />
    <Compile Include="Advisor\MountedContext.cs" />
    <Compile Include="Advisor\ScoreWeights.cs" />
    <Compile Include="Advisor\WeaponScore.cs" />
    <Compile Include="Advisor\WeaponStats.cs" />
    <Compile Include="Integration\EngineDesignEvaluator.cs" />
    <Compile Include="Integration\SmithingConnector.cs" />
    <Compile Include="Integration\SmithingBehavior.cs" />
    <Compile Include="Integration\SmithingLog.cs" />
    <Compile Include="Integration\SmithingLogTrace.cs" />
    <Compile Include="Integration\TravelStaminaBehavior.cs" />
    <Compile Include="SmithingSuiteSubModule.cs" />
    <Compile Include="SmithingSuiteConfig.cs" />
    <Compile Include="SmithingSuiteMcmSettings.cs" />
    <Compile Include="UI\AdvisorPrefabExtensions.cs" />
    <Compile Include="UI\AdvisorTextRenderer.cs" />
    <Compile Include="UI\UiExtensionBridge.cs" />
    <Compile Include="UI\WeaponDesignAdvisorMixin.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="SubModule.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="UI\Prefabs\AdvisorTriggerButton.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="UI\Prefabs\AdvisorPopup.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Post-build: deploy to the Bannerlord Modules directory with the expected structure. -->
  <Target Name="CopyToBannerlord" AfterTargets="Build">
    <PropertyGroup>
      <ModOutputPath>$(BannerlordModulesPath)\SmithingSuite</ModOutputPath>
    </PropertyGroup>
    <MakeDir Directories="$(ModOutputPath);$(ModOutputPath)\bin\Win64_Shipping_Client;$(ModOutputPath)\GUI\Prefabs" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModOutputPath)\bin\Win64_Shipping_Client" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(ProjectDir)SubModule.xml" DestinationFiles="$(ModOutputPath)\SubModule.xml" />
    <!-- The advisor's XML fragments - PrefabExtensionFileName (AdvisorPrefabExtensions.cs) searches
         this module's GUI folder recursively at runtime, so they must be deployed alongside the DLL. -->
    <Copy SourceFiles="$(ProjectDir)UI\Prefabs\AdvisorTriggerButton.xml;$(ProjectDir)UI\Prefabs\AdvisorPopup.xml" DestinationFolder="$(ModOutputPath)\GUI\Prefabs" />
    <!-- Language files (language_data.xml + std_smithingsuite_strings.xml) - loaded by the game's
         localisation manager from ModuleData\Languages at startup, no SubModule.xml <Xmls> entry
         needed. Recursive copy mirrors AutoTrader's own CopyToBannerlord target. -->
    <ItemGroup>
      <ModuleDataFiles Include="$(ProjectDir)ModuleData\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleDataFiles)" DestinationFiles="@(ModuleDataFiles->'$(ModOutputPath)\ModuleData\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="Deployed Smithing Suite to $(ModOutputPath)" Importance="high" />
  </Target>
</Project>
